# MorphoPack environment variables
# Copy to .env and fill in your values

# Backend database (SQLite used by default if not set)
DATABASE_URL=sqlite:///morphopack.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/morphopack

# Blender executable path (auto-detected on Windows if not set)
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe

# Backend port
PORT=7071
